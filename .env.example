# ===========================================
# Auteur.film Environment Variables
# Copy this to .env.local and fill in values
# ===========================================

# ----- SUPABASE -----
# Get from: https://supabase.com/dashboard → Your Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ----- YOUTUBE API -----
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
YOUTUBE_CLIENT_ID=xxxxx.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=GOCSPX-xxxxx

# Get refresh token from: https://developers.google.com/oauthplayground
# (Use your own OAuth credentials, authorize youtube.upload scope)
YOUTUBE_REFRESH_TOKEN=1//xxxxx

# Get from: YouTube Studio → Settings → Channel → Advanced settings
YOUTUBE_CHANNEL_ID=UCxxxxx

# ----- COINBASE DEVELOPER PLATFORM (Optional) -----
# Get from: https://portal.cdp.coinbase.com
# Only needed if using Coinbase Onramp for fiat → USDC
NEXT_PUBLIC_CDP_API_KEY=

# ----- APP CONFIG -----
# Your deployed URL (update after Railway deployment)
NEXT_PUBLIC_APP_URL=http://localhost:3000
